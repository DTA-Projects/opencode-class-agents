# Canvas credentials for the class agents.
#
# On each new machine: copy this file to .env and fill in YOUR values.
# NEVER commit .env (it is gitignored). This .env.example is safe to commit.
#
# HOW TO GET A FRESH COOKIE:
#   1. Log into Canvas in your browser.
#   2. Press F12 to open DevTools -> Network tab.
#   3. Refresh the Canvas page.
#   4. Click any request going to your Canvas domain.
#   5. Under "Request Headers", find the "cookie:" line and copy its ENTIRE value.
#   6. Paste it after CANVAS_COOKIE= below (one line, no quotes).
#
# The cookie expires with your login session (days/weeks). When canvas.mjs
# commands start failing, refresh the cookie on that machine.

CANVAS_COOKIE=PASTE_THE_FULL_COOKIE_HEADER_VALUE_HERE

# Your school's Canvas origin, with no trailing slash and no path.
CANVAS_API_BASE=https://<your-school>.instructure.com

# Optional: if the admin ever re-enables access tokens, use this instead of the cookie.
# CANVAS_API_TOKEN=